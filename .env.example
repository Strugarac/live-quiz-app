# Kopiraj u .env (koji se NE komituje) i popuni.
DOCKERHUB_USER=strugarac
APP_VERSION=1.0.0
# Port na kome je aplikacija dostupna spolja (80 na serveru; lokalno npr. 8081).
HTTP_PORT=80
# Origin (sema + host + port, BEZ putanje i bez kose crte na kraju) na kome studenti otvaraju
# aplikaciju - ide u QR kod i u WebSocket/CORS dozvole. Na serveru: https://imi.pmf.kg.ac.rs
PUBLIC_URL=http://localhost
DB_PASSWORD=promeni-me
# Putanja pod kojom aplikacija zivi; mora da se poklapa sa frontend/.env.production.
APP_BASE_PATH=/livequiz
# relay = RabbitMQ (puna arhitektura), simple = ugradjeni broker (jedna instanca, bez RabbitMQ-a).
WS_BROKER_MODE=relay
RABBITMQ_PASSWORD=promeni-me
