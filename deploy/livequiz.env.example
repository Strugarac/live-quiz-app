# Kopirati u /opt/livequiz/livequiz.env (chmod 600, vlasnik livequiz) i popuniti.
# Cita ga systemd (EnvironmentFile) i prosledjuje backendu.
SPRING_PROFILES_ACTIVE=prod

# Backend slusa samo lokalno; spolja mu se prilazi iskljucivo kroz reverse proxy.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# PostgreSQL na istom serveru
DB_URL=jdbc:postgresql://localhost:5432/livequiz
DB_USERNAME=livequiz
DB_PASSWORD=promeni-me

# Putanja pod kojom aplikacija zivi (mora da se poklapa sa frontend build-om)
APP_BASE_PATH=/livequiz

# Ugradjeni STOMP broker - jedna instanca, bez RabbitMQ-a
WS_BROKER_MODE=simple

# Javne adrese: ulaze u QR kod i u URL-ove slika...
JOIN_BASE_URL=https://imi.pmf.kg.ac.rs/livequiz/join
MEDIA_PUBLIC_BASE_URL=https://imi.pmf.kg.ac.rs/livequiz
# ...a ovo je origin (bez putanje) koji sme da otvori WebSocket
WS_ALLOWED_ORIGINS=https://imi.pmf.kg.ac.rs
