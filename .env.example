# Kopiraj u .env (koji se NE komituje) i popuni.
DOCKERHUB_USER=strugarac
APP_VERSION=1.0.0
# Port na kome je aplikacija dostupna spolja (80 na serveru; lokalno npr. 8081).
HTTP_PORT=80
# Adresa na kojoj studenti otvaraju aplikaciju - ide u QR kod i u WebSocket/CORS dozvole.
PUBLIC_URL=http://localhost
DB_PASSWORD=promeni-me
RABBITMQ_PASSWORD=promeni-me
